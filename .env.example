# 复制为 .env 后填入真实值。.env 已被 .gitignore 排除，不会进仓库。

# OpenRouter API Key（https://openrouter.ai 注册后申请）
# 免费模型用 :free 后缀，例如 nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_API_KEY=

# 高德地图 API Key（https://console.amap.com 申请，有免费额度）
AMAP_MAPS_API_KEY=

# 12306 MCP 服务端路径（默认用本仓库相对路径，一般不用改）
# MCP_12306_SERVER=/path/to/12306-mcp/build/index.js
